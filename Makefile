.PHONY: sync lint typecheck pyright test test-pg test-pg-reset check migrate revision run deploy vercel-deploy webhook-set webhook-delete webhook-info logs-vercel fly-init deploy-fly logs backup restore restart clean

# Install/sync dependencies from lockfile
sync:
	uv sync

# Lint code and verify formatting
lint:
	uv run ruff check .
	uv run ruff format --check .

# Strict static type checking of src/ and alembic/ (env.py is code too — it is
# outside src/ and would otherwise be checked by nothing).
typecheck:
	uv run mypy src alembic

# Editor-side check: the same basedpyright engine Zed runs, reading
# pyrightconfig.json (venv = .venv). Slower than mypy; opt-in.
pyright:
	uv run basedpyright

# Run unit tests (quiet)
test:
	uv run pytest -q

# Opt-in SQLite<->Postgres drift guard. Needs a scratch database:
#   make test-pg TEST_DATABASE_URL='postgresql://user:pass@host/db'
test-pg:
	@test -n "$(TEST_DATABASE_URL)" || { echo "usage: make test-pg TEST_DATABASE_URL='postgresql://…'"; exit 1; }
	@TEST_DATABASE_URL='$(TEST_DATABASE_URL)' uv run pytest tests/integration/test_postgres_repo.py -q

# Destructive: rewinds the schema to 0002 and back (checks the 0003 sequence fix).
# Scratch database only — never point this at a database you care about.
test-pg-reset:
	@test -n "$(TEST_DATABASE_URL_RESET)" || { echo "usage: make test-pg-reset TEST_DATABASE_URL_RESET='postgresql://…'"; exit 1; }
	@TEST_DATABASE_URL_RESET='$(TEST_DATABASE_URL_RESET)' uv run pytest tests/integration/test_migration_0003_sequence.py -q

# Full local gate: lint + types + tests
check: lint typecheck test

# Apply DB migrations to head (local SQLite, or Neon when DATABASE_URL is set
# in the environment or .env)
migrate:
	mkdir -p data
	uv run alembic upgrade head

# Create autogenerated migration: make revision MSG="add items table"
revision:
	uv run alembic revision --autogenerate -m "$(MSG)"

# Run bot locally (long polling)
run:
	uv run python -m src.main

# Deploy to Vercel (prod) and (re)register the webhook. Migrations run
# separately: `make migrate` (DATABASE_URL from env/.env, see README "Deploy").
deploy: vercel-deploy webhook-set

# Push the code to Vercel only (no webhook call).
vercel-deploy:
	vercel deploy --prod

# Register the Telegram webhook (needs WEBHOOK_BASE_URL + WEBHOOK_SECRET).
webhook-set:
	uv run python -m src.adapters.webhook.manage set

# Unregister the webhook (switch back to long polling).
webhook-delete:
	uv run python -m src.adapters.webhook.manage delete

# Show the current webhook registration.
webhook-info:
	uv run python -m src.adapters.webhook.manage info

# Print recent production runtime logs (one-shot, default window: last 30m).
# Run it right after reproducing an issue: on Hobby `--since 1h` is rejected.
logs-vercel:
	vercel logs --environment production --since 30m

# --- Fly.io path: REJECTED (ADR-0001). Kept as an optional non-prod fallback. ---

# Deploy to Fly.io (rejected; see ADR-0001)
deploy-fly:
	fly deploy

# First-time Fly.io setup (rejected; ADR-0001): app + volume + secrets reminder
fly-init:
	fly launch --no-deploy --copy-config
	fly volumes create data --size 1 --region ams
	@echo "Next: fly secrets set BOT_TOKEN=... CUSTOMER_ID=... EXECUTOR_ID=...  &&  make deploy"

# Tail production logs on Fly.io (rejected path)
logs:
	fly logs

# Dump production SQLite to dated backup file
backup:
	fly ssh console -C "sqlite3 /data/bot.db .dump" > backup-$$(date +%F).sql

# Restore a dump into the volume DB: make restore FILE=backup-2026-10-15.sql
# A .dump has no DROP TABLE, so remove the current file(s) first (fresh inode),
# load the dump into an empty DB, then restart the machine to reopen it.
restore:
	@test -n "$(FILE)" || { echo "usage: make restore FILE=backup-YYYY-MM-DD.sql"; exit 1; }
	cat $(FILE) | fly ssh console -C "rm -f /data/bot.db /data/bot.db-wal /data/bot.db-shm && sqlite3 /data/bot.db"
	fly machines restart

# Restart the app machine (reopens the volume DB, drains queued updates)
restart:
	fly machines restart

# Remove Python bytecode caches
clean:
	find . -name "__pycache__" -type d -prune -exec rm -rf {} +
