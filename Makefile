.PHONY: sync lint typecheck test check migrate revision run deploy logs backup clean

# Install/sync dependencies from lockfile
sync:
	uv sync

# Lint code and verify formatting
lint:
	uv run ruff check .
	uv run ruff format --check .

# Strict static type checking of src/
typecheck:
	uv run mypy src

# Run unit tests (quiet)
test:
	uv run pytest -q

# Full local gate: lint + types + tests
check: lint typecheck test

# Apply DB migrations to head
migrate:
	mkdir -p data
	uv run alembic upgrade head

# Create autogenerated migration: make revision MSG="add items table"
revision:
	uv run alembic revision --autogenerate -m "$(MSG)"

# Run bot locally (long polling)
run:
	uv run python -m src.main

# Deploy to Fly.io (free tier, volume /data)
deploy:
	fly deploy

# Tail production logs on Fly.io
logs:
	fly logs

# Dump production SQLite to dated backup file
backup:
	fly ssh console -C "sqlite3 /data/bot.db .dump" > backup-$$(date +%F).sql

# Remove Python bytecode caches
clean:
	find . -name "__pycache__" -type d -prune -exec rm -rf {} +
