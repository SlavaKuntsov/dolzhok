# Copy to .env and fill. Never commit .env.
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
CUSTOMER_ID=111111111
EXECUTOR_ID=222222222
# Local dev: SQLite file. Prod (Vercel/Neon): postgresql+asyncpg://… (see README).
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
LOG_LEVEL=INFO

# Webhook mode (prod / Vercel). Leave empty locally to use long polling.
# WEBHOOK_BASE_URL=https://<app>.vercel.app
# WEBHOOK_SECRET=<random string, echoed back by Telegram in a header>
# WEBHOOK_PATH=/webhook
